<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="key_infisical">
  <description>PHP CodeSniffer configuration for the Key Infisical module.</description>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <file>.</file>

  <exclude-pattern>.ddev/</exclude-pattern>
  <exclude-pattern>vendor/</exclude-pattern>
  <exclude-pattern>node_modules/</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
